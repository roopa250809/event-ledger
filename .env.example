# Replace both secrets before any non-local deployment.
ACCOUNT_SERVICE_API_KEY=replace-with-at-least-20-random-characters
GATEWAY_JWT_SECRET=replace-with-a-base64-encoded-random-secret-of-at-least-32-bytes
GATEWAY_JWT_ISSUER=event-ledger-local
GATEWAY_JWT_AUDIENCE=event-ledger-api
# Set this for a production OAuth2/OIDC provider; it takes precedence over the local HMAC secret.
GATEWAY_JWT_JWK_SET_URI=
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_SSL_KEY_STORE_PASSWORD=changeit
KAFKA_FALLBACK_ENABLED=true
KAFKA_FALLBACK_TOPIC=event-ledger.account-retry.v1
KAFKA_RETRY_INTERVAL=5s
